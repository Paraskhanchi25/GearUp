# ==============================================================================
# GEAR UP — Root Environment Variables Template
# Copy this file to .env and populate with your credentials.
# NEVER commit your actual .env file or API keys to Git!
# ==============================================================================

# 1. Google Maps Platform API Key
# Required for Google Maps JavaScript API, custom vehicle markers, and radius circles.
# Obtain from Google Cloud Console: https://console.cloud.google.com/google/maps-apis
# APIs to enable: "Maps JavaScript API", "Places API", "Geocoding API"
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 2. AI Services (Google Gemini / LLM backend)
# Required for live generative responses in AI Bike Buddy & Resale Studio
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 3. PostgreSQL Database Connection
# Required for PostgreSQL + PostGIS server connection
DATABASE_URL=postgresql://gearup_user:your_password@localhost:5432/gearup_db

# 4. Storage & Media Bucket (AWS S3 / Supabase / Google Cloud Storage)
STORAGE_BUCKET_NAME=gearup-media-storage
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
