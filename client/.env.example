# ==============================================================================
# GEAR UP Web Client — Environment Configuration Template
# Place in client/.env for Vite application runtime
# ==============================================================================

# Google Maps Platform Key (Used in Explore page interactive map)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Gemini API Key (Optional: client includes an intelligent fallback mechanic engine)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
